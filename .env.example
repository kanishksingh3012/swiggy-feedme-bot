# Groq — console.groq.com -> API Keys
GROQ_API_KEY=

# Swiggy MCP — OAuth 2.1 PKCE, no refresh token (5-day expiry, re-run login on 401)
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
SWIGGY_CREDENTIALS_PATH=~/.config/feedme-bot/swiggy_credentials.json

# WhatsApp Cloud API — Meta developer console, App ID 5460715127486308
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Phase 1: personal use only — the single WhatsApp number allowed to talk to the bot
ALLOWED_WHATSAPP_NUMBER=
